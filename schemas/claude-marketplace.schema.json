{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RewardopediaHQ/rewardopedia-plugin/schemas/claude-marketplace.schema.json",
  "title": "Claude Code marketplace (repository subset)",
  "description": "The subset of .claude-plugin/marketplace.json fields this repository uses, from https://code.claude.com/docs/en/plugins/marketplace-reference (retrieved 2026-09-27). The official check is `claude plugin validate --strict`.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "string",
            "pattern": "^\\./(?!.*\\.\\.)"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["name", "source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "owner", "plugins"],
  "additionalProperties": false
}
